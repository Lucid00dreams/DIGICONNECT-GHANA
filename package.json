  "private": true,
  "description": "DigiConnect Ghana - Official Website & ConnectHub Platform",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "node scripts/build-backend.js",
