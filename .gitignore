# Root .gitignore for DigiConnect Ghana Workspace

# Dependencies
node_modules/
*/node_modules/

# Production builds & compiled artifacts
dist/
*/dist/
build/
*/build/
.next/
*/.next/
out/
*/out/

# Environment Variables & Secrets
.env
.env.*
*.env
backend/.env
frontend/.env.local
!*.env.example

# Logs & Temporary debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*/logs/
*.tsbuildinfo

# Runtime Data Storage (preserve seed.ts)
backend/src/data/db.json
backend/src/data/*.tmp
backend/src/data/*.bak

# Runtime Uploads (preserve .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
frontend/public/images/uploads/*
!frontend/public/images/uploads/.gitkeep

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
