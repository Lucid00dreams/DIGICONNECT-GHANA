# Root .gitignore for DigiConnect Ghana Workspace

# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
build/
*/dist/
*/build/
.next/
*/.next/
out/
*/out/

# Environment Variables
.env
.env.*
*.env
backend/.env
frontend/.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*/logs/
*.tsbuildinfo

# Uploads (preserve .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# System files
.DS_Store
Thumbs.db
