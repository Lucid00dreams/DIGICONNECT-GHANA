# ============================================================================
# DigiConnect Ghana - Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit your actual .env file to Git!
# ============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated for multiple origins, e.g. https://digiconnectghana.org,http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Persistent Data Storage (default: local JSON, or mounted volume /var/data/db.json on Render)
DATA_FILE_PATH=./src/data/db.json
UPLOAD_DIR=./uploads

# Administrative Authentication Credentials
ADMIN_EMAIL=admin@digiconnectghana.org
ADMIN_PASSWORD=your_strong_admin_password_here

# Cryptographic Secrets (generate a random 32-byte hex string in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_32_byte_random_hex_session_secret
API_KEY=your_secure_internal_api_key
